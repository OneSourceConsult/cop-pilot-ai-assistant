# Display name exposed by the backend.
APP_NAME=LLM Layer
# Interface the API binds to.
APP_HOST=0.0.0.0
# Port the API listens on.
APP_PORT=8010
# Allowed CORS origins for the frontend.
APP_CORS_ORIGINS=*

# OpenAI-compatible provider base URL.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# API key for the LLM provider.
OPENAI_API_KEY=
# Model name used for chat completions.
OPENAI_MODEL=openrouter/free
# Sampling temperature for the model.
OPENAI_TEMPERATURE=0
# Optional HTTP-Referer header sent to the LLM provider.
LLM_HTTP_REFERER=http://127.0.0.1:4173
# Optional application title header sent to the LLM provider.
LLM_APPLICATION_NAME=llm-layer-mcp-test-console

# Logical MCP server name used in logs and traces.
MCP_SERVER_NAME=openslice
# MCP transport type: streamable_http, sse, or stdio.
MCP_TRANSPORT=streamable_http
# MCP endpoint URL for network transports.
MCP_SERVER_URL=http://127.0.0.1:8003/mcp
# Command used only for stdio transport.
MCP_SERVER_COMMAND=
# Comma-separated args used only for stdio transport.
MCP_SERVER_ARGS=
# Extra JSON headers sent to the MCP server.
MCP_SERVER_HEADERS={"Accept":"application/json, text/event-stream"}
# MCP auth mode: none, static_bearer, oauth_client_credentials, or oauth_password.
MCP_AUTH_MODE=none
# Static bearer token when MCP_AUTH_MODE=static_bearer.
MCP_AUTH_TOKEN=
# OAuth token endpoint for MCP auth.
MCP_AUTH_TOKEN_URL=
# OAuth client id for MCP auth.
MCP_AUTH_CLIENT_ID=
# OAuth client secret for MCP auth when required.
MCP_AUTH_CLIENT_SECRET=
# Username for password-grant MCP auth.
MCP_AUTH_USERNAME=
# Password for password-grant MCP auth.
MCP_AUTH_PASSWORD=
# Optional OAuth scope for MCP auth.
MCP_AUTH_SCOPE=
# Optional OAuth audience for MCP auth.
MCP_AUTH_AUDIENCE=
# Seconds before expiry when cached MCP tokens are refreshed.
MCP_AUTH_REFRESH_SKEW_SECONDS=30
# Timeout for MCP connection and tool discovery.
MCP_CONNECT_TIMEOUT_SECONDS=5
# Timeout for individual MCP tool execution.
MCP_READ_TIMEOUT_SECONDS=20
# Number of retries for safe MCP read calls.
MCP_READ_RETRIES=1
# Backoff base between safe MCP retries.
MCP_RETRY_BACKOFF_SECONDS=0.5
# Cooldown window after MCP availability failures.
MCP_CIRCUIT_BREAKER_SECONDS=20

# Maximum LLM tool-selection rounds per request.
CHAT_MAX_TOOL_ROUNDS=6
# MCP tools treated as safe read-only operations.
PRODUCT_READ_TOOL_NAMES=getOSLProductCatalogs,getOSLServiceCatalogs,getOSLProductCategories,getOSLProductOfferingsInCategory,getOSLProductOfferingByProductOfferingId,getOSLProductByProductSpecificationId,searchOSLProductOfferings,getProductOrder
# MCP tools treated as guarded write operations.
PRODUCT_WRITE_TOOL_NAMES=createProductOrder,createServiceOrder
# Base system prompt used by the backend assistant.
CHAT_SYSTEM_PROMPT=You are a concise product operations copilot. Help users explore products and prepare guarded product orders through the connected MCP tools.
